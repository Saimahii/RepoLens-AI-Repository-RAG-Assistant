# Copy this file to .env and fill in your real values.
# .env is git-ignored. Never commit real secrets.

# MySQL connection: mysql+pymysql://USER:PASSWORD@HOST:PORT/DATABASE
# If the password contains @ : / or #, URL-encode it (e.g. @ becomes %40).
DATABASE_URL=mysql+pymysql://repolens_user:YOUR_PASSWORD@localhost:3306/repolens

# Gemini (used from Phase 3). Check the Google Gen AI docs for the current model name.
GEMINI_API_KEY=
GEMINI_MODEL=

# Folders, relative to the backend/ folder
CHROMA_PATH=vector_store
REPOS_PATH=repos

# How long a git clone may run before it is cancelled
CLONE_TIMEOUT_SECONDS=120
